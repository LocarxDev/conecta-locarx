# Copie para .env SÓ no seu computador. No Railway, cadastre em Variables. Nunca suba o .env para o GitHub.
DATABASE_URL=postgres://usuario:senha@host:5432/banco
PGSSL=disable
# 32 bytes aleatórios em base64 — gere com: openssl rand -base64 32
CHAVE_CRIPTOGRAFIA=
APP_URL=https://conecta.locarx.com.br
FRONTEND_ORIGINS=https://conecta.locarx.com.br,https://adminconecta.locarx.com.br
TRUST_PROXY=2
RESEND_API_KEY=
EMAIL_FROM=Conecta LocarX <nao-responder@send.locarx.com.br>
ADMIN_INICIAL_EMAIL=silas@auniti.com.br
ADMIN_INICIAL_NOME=Silas Moreira
PORT=3000
# WhatsApp (etapa 2) — Evolution API
EVOLUTION_URL=http://evolution-api.railway.internal:8080
EVOLUTION_API_KEY=
WEBHOOK_BASE_URL=http://conecta-api.railway.internal:3000
# gere com: openssl rand -hex 32
WEBHOOK_SEGREDO=
# API LocarX (etapa 4) — homologação até validar os formatos
LOCARX_API_URL=https://portalhml.locarx.com.br/api
LOCARX_API_TOKEN=
# MCP (opcional): gere com openssl rand -hex 32
MCP_TOKEN=
# Só no computador: IA simulada (nunca em produção)
# IA_SIMULADA=1
# Só para testar no computador (http://localhost). NUNCA no Railway:
# COOKIE_INSEGURO_LOCAL=1
# Pagamento Pix pelo WhatsApp (AbacatePay) — chave da REDE (conta do franqueador). Sem ela, pagamento online desligado.
# Chave de Dev mode = transações simuladas; chave de produção = reais (o ambiente vem da chave, não da URL).
ABACATEPAY_API_KEY=
# gere com: openssl rand -hex 32 — e cadastre o webhook no painel do AbacatePay com a URL:
#   https://<api-publica>/api/webhooks/abacatepay/<ESTE_SEGREDO>?webhookSecret=<ESTE_SEGREDO>
ABACATEPAY_WEBHOOK_SECRET=
# opcional: chave pública da AbacatePay (documentação de webhooks, constante ABACATEPAY_PUBLIC_KEY) para conferir a assinatura HMAC
ABACATEPAY_PUBLIC_KEY=
# validade do Pix em minutos (padrão 30)
PIX_VALIDADE_MINUTOS=30
